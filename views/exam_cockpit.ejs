<!DOCTYPE html>
<html lang="da">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Eksamens-cockpit | Rizzlerpies</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #171717;
      --muted: #666666;
      --line: #d7d7d7;
      --paper: #f7f7f4;
      --surface: #ffffff;
      --accent: #8a1f1f;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.5;
    }

    main {
      width: min(1120px, calc(100% - 40px));
      margin: 0 auto;
      padding: 40px 0 56px;
    }

    header {
      border-bottom: 2px solid var(--ink);
      padding-bottom: 18px;
      margin-bottom: 24px;
    }

    .eyebrow {
      color: var(--accent);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0;
      margin: 0 0 8px;
      text-transform: uppercase;
    }

    h1 {
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(34px, 6vw, 66px);
      font-weight: 400;
      letter-spacing: 0;
      line-height: 1;
      margin: 0;
    }

    .intro {
      color: var(--muted);
      font-size: 16px;
      max-width: 760px;
      margin: 14px 0 0;
    }

    .meta {
      border-bottom: 1px solid var(--line);
      display: grid;
      gap: 12px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-bottom: 22px;
      padding-bottom: 18px;
    }

    .meta div {
      min-width: 0;
    }

    .label {
      color: var(--muted);
      display: block;
      font-size: 12px;
      margin-bottom: 2px;
      text-transform: uppercase;
    }

    .value {
      font-family: Consolas, "Courier New", monospace;
      font-size: 14px;
      overflow-wrap: anywhere;
    }

    table {
      background: var(--surface);
      border-collapse: collapse;
      width: 100%;
    }

    th,
    td {
      border-bottom: 1px solid var(--line);
      padding: 13px 12px;
      text-align: left;
      vertical-align: top;
    }

    th {
      border-bottom: 2px solid var(--ink);
      color: var(--muted);
      font-size: 12px;
      text-transform: uppercase;
    }

    td:first-child {
      color: var(--muted);
      font-family: Consolas, "Courier New", monospace;
      font-size: 13px;
      white-space: nowrap;
      width: 64px;
    }

    .topic {
      font-weight: 700;
      min-width: 220px;
    }

    .note {
      color: var(--muted);
      font-size: 14px;
    }

    a {
      color: var(--ink);
      text-decoration-color: var(--accent);
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }

    a:hover {
      color: var(--accent);
    }

    code {
      font-family: Consolas, "Courier New", monospace;
      font-size: 13px;
    }

    .placeholder {
      color: var(--accent);
      font-weight: 700;
    }

    .showcase {
      align-items: center;
      background: var(--surface);
      border: 1px solid var(--line);
      display: flex;
      gap: 14px;
      justify-content: space-between;
      margin: 0 0 22px;
      padding: 12px;
    }

    .showcase-copy {
      min-width: 0;
    }

    .showcase-title {
      font-size: 12px;
      font-weight: 700;
      margin: 0 0 2px;
      text-transform: uppercase;
    }

    .showcase-current {
      font-size: 14px;
      margin: 0;
      overflow-wrap: anywhere;
    }

    .showcase-button {
      background: var(--ink);
      border: 1px solid var(--ink);
      color: var(--surface);
      cursor: pointer;
      font: 700 13px Arial, Helvetica, sans-serif;
      min-height: 38px;
      padding: 0 16px;
      white-space: nowrap;
    }

    .showcase-button:hover,
    .showcase-button:focus-visible {
      background: var(--accent);
      border-color: var(--accent);
      outline: none;
    }

    .showcase-button:disabled {
      background: var(--surface);
      border-color: var(--line);
      color: var(--muted);
      cursor: default;
    }

    @media (max-width: 760px) {
      main {
        width: min(100% - 24px, 1120px);
        padding-top: 24px;
      }

      .meta {
        grid-template-columns: 1fr;
      }

      .showcase {
        align-items: stretch;
        flex-direction: column;
      }

      th:nth-child(4),
      td:nth-child(4) {
        display: none;
      }

      td:first-child {
        white-space: normal;
      }
    }
  </style>
</head>
<body>
  <main>
    <header>
      <p class="eyebrow">Rizzlerpies eksamen</p>
      <h1>Eksamens-cockpit</h1>
      <p class="intro">
        Samlet præsentationsside til database-migration, drift, CI, observability og dokumentation.
        Brug listen fra toppen og ned, så casen kan fremvises uden at lede rundt i repoet.
      </p>
    </header>

    <section class="meta" aria-label="Cockpit metadata">
      <div>
        <span class="label">App</span>
        <span class="value"><a href="https://20.251.147.233/" target="_blank" rel="noreferrer">https://20.251.147.233/</a></span>
      </div>
      <div>
        <span class="label">Cockpit endpoint</span>
        <span class="value">/exam-cockpit</span>
      </div>
      <div>
        <span class="label">Repository</span>
        <span class="value"><a href="https://github.com/TheRizzlersOrg4Semester/Rizzlerpies" target="_blank" rel="noreferrer">TheRizzlersOrg4Semester/Rizzlerpies</a></span>
      </div>
    </section>

    <section class="showcase" aria-label="Funktionelt showcase flow">
      <div class="showcase-copy">
        <p class="showcase-title">Showcase flow</p>
        <p class="showcase-current" id="showcase-current">01 Arkitekturdiagram</p>
      </div>
      <button class="showcase-button" id="showcase-next" type="button">Næste</button>
    </section>

    <table aria-label="Eksamenslinks">
      <thead>
        <tr>
          <th>#</th>
          <th>Emne</th>
          <th>Link</th>
          <th>Note</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>01</td>
          <td class="topic">Arkitekturdiagram</td>
          <td><a href="/exam-cockpit/assets/arkitektur-diagram.png" target="_blank" rel="noreferrer">Åbn arkitekturdiagram</a></td>
          <td class="note">PNG-diagram fra cockpit-assets i views-mappen.</td>
        </tr>
        <tr>
          <td>02</td>
          <td class="topic">/apidocs</td>
          <td><a href="/apidocs" target="_blank" rel="noreferrer">Åbn Swagger UI</a></td>
          <td class="note">OpenAPI-visning fra Express appen.</td>
        </tr>
        <tr>
          <td>03</td>
          <td class="topic">GitHub repo</td>
          <td><a href="https://github.com/TheRizzlersOrg4Semester/Rizzlerpies" target="_blank" rel="noreferrer">Repository</a></td>
          <td class="note">Kodebase, commits, branches og pull requests.</td>
        </tr>
        <tr>
          <td>04</td>
          <td class="topic">db.js</td>
          <td><a href="https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/db.js" target="_blank" rel="noreferrer">PostgreSQL runtime access</a></td>
          <td class="note">Appens aktive databaseadgang via <code>pg.Pool</code>.</td>
        </tr>
        <tr>
          <td>05</td>
          <td class="topic">Migrationsfil</td>
          <td><a href="https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/migrations/1779722203738_initial-recipe-schema.js" target="_blank" rel="noreferrer">Initial recipe schema</a></td>
          <td class="note">Schema for recipes, ingredients, tags og relationstabeller.</td>
        </tr>
        <tr>
          <td>06</td>
          <td class="topic">SQLite → PostgreSQL migrationsscript</td>
          <td><a href="https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/scripts/db/migrate-sqlite-to-postgres.js" target="_blank" rel="noreferrer">Data migration script</a></td>
          <td class="note">One-time migrering af eksisterende SQLite-data.</td>
        </tr>
        <tr>
          <td>07</td>
          <td class="topic">Terminal til migration</td>
          <td><a href="https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/docs/run-data-migration.md" target="_blank" rel="noreferrer">Run data migration</a></td>
          <td class="note">Kommandoer til DB VM, schema migration og data migration.</td>
        </tr>
        <tr>
          <td>08</td>
          <td class="topic">Row count verification</td>
          <td>
            <a href="/exam-cockpit/assets/confirmed-rows.png" target="_blank" rel="noreferrer">Åbn confirmed rows</a>
            <span class="placeholder"> / </span>
            <a href="https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/docs/postgres-cutover-evidence.md" target="_blank" rel="noreferrer">Cutover evidence</a>
          </td>
          <td class="note">Row counts og migrationsbevis. Sekundært: <a href="https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/docs/production-data-migration-runbook.md#4-data-migration" target="_blank" rel="noreferrer">runbook commands</a>.</td>
        </tr>
        <tr>
          <td>09</td>
          <td class="topic">docker-compose.yml</td>
          <td><a href="https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/docker-compose.yml" target="_blank" rel="noreferrer">Compose stack</a></td>
          <td class="note">Lokal Postgres, app-a, app-b og Nginx proxy.</td>
        </tr>
        <tr>
          <td>10</td>
          <td class="topic">Nginx config</td>
          <td><a href="https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/ops/nginx/default.conf" target="_blank" rel="noreferrer">ops/nginx/default.conf</a></td>
          <td class="note">Reverse proxy og health endpoint.</td>
        </tr>
        <tr>
          <td>11</td>
          <td class="topic">Docker compose ps</td>
          <td><a href="/exam-cockpit/assets/docker-compose-ps.png" target="_blank" rel="noreferrer">Åbn docker compose ps</a></td>
          <td class="note">Container status på proxy, app health og ports.</td>
        </tr>
        <tr>
          <td>12</td>
          <td class="topic">/healthz</td>
          <td><a href="/healthz" target="_blank" rel="noreferrer">Åbn healthz</a></td>
          <td class="note">Liveness endpoint uden DB-check.</td>
        </tr>
        <tr>
          <td>13</td>
          <td class="topic">/readyz</td>
          <td><a href="/readyz" target="_blank" rel="noreferrer">Åbn readyz</a></td>
          <td class="note">Readiness endpoint med PostgreSQL connectivity-check.</td>
        </tr>
        <tr>
          <td>14</td>
          <td class="topic">GitHub Actions successful run</td>
          <td><a href="https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/actions/runs/26878409662" target="_blank" rel="noreferrer">Successful Node CI run</a></td>
          <td class="note">Ny succesfuld GitHub Actions-run fra eksamensevidence.</td>
        </tr>
        <tr>
          <td>15</td>
          <td class="topic">.github/workflows/node-ci.yml</td>
          <td><a href="https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/.github/workflows/node-ci.yml" target="_blank" rel="noreferrer">CI workflow</a></td>
          <td class="note">Lint, migration, data import, app start og smoke test.</td>
        </tr>
        <tr>
          <td>16</td>
          <td class="topic">tracing.js</td>
          <td><a href="https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/tracing.js" target="_blank" rel="noreferrer">OpenTelemetry setup</a></td>
          <td class="note">Tracing setup og OTLP exporter.</td>
        </tr>
        <tr>
          <td>17</td>
          <td class="topic">SigNoz dashboard</td>
          <td><a href="http://20.251.147.233:8080/dashboard/019dd42a-6f2e-7630-bb68-beb6ed248aed?relativeTime=1d" target="_blank" rel="noreferrer">Åbn SigNoz dashboard</a></td>
          <td class="note">Brug det konkrete SigNoz-dashboard fra eksamensmiljøet.</td>
        </tr>
        <tr>
          <td>18</td>
          <td class="topic">SigNoz failed requests</td>
          <td>
            <a href="/exam-cockpit/evidence/failed-requests-by-url" target="_blank" rel="noreferrer">Vis CSV-indhold</a>
            <span class="placeholder"> / </span>
            <a href="/exam-cockpit/evidence/failed-requests-by-url/download">Download CSV</a>
          </td>
          <td class="note">CSV-uddrag fra første gang de fejlede requests blev opdaget.</td>
        </tr>
      </tbody>
    </table>
  </main>
  <script>
    const showcaseFlow = [
      { label: '01 Arkitekturdiagram', hrefs: ['/exam-cockpit/assets/arkitektur-diagram.png'] },
      { label: '02 /apidocs', hrefs: ['/apidocs'] },
      { label: '01 Arkitekturdiagram', hrefs: ['/exam-cockpit/assets/arkitektur-diagram.png'] },
      { label: '04 db.js', hrefs: ['https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/db.js'] },
      { label: '05 Migrationsfil', hrefs: ['https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/migrations/1779722203738_initial-recipe-schema.js'] },
      { label: '08 Row count verification', hrefs: ['/exam-cockpit/assets/confirmed-rows.png'] },
      { label: '06 SQLite til PostgreSQL migrationsscript', hrefs: ['https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/scripts/db/migrate-sqlite-to-postgres.js'] },
      { label: '13 /readyz', hrefs: ['/readyz'] },
      { label: '09 docker-compose.yml', hrefs: ['https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/docker-compose.yml'] },
      { label: '10 Nginx config', hrefs: ['https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/ops/nginx/default.conf'] },
      { label: '11 Docker compose ps', hrefs: ['/exam-cockpit/assets/docker-compose-ps.png'] },
      { label: '12+13 Health checks', hrefs: ['/healthz', '/readyz'] },
      { label: '14 GitHub Actions successful run', hrefs: ['https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/actions/runs/26878409662'] },
      { label: '15 CI workflow', hrefs: ['https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/.github/workflows/node-ci.yml'] },
      { label: 'GitHub Actions job', hrefs: ['https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/actions/runs/26878409662/job/79271791701'] },
      { label: '16 tracing.js', hrefs: ['https://github.com/TheRizzlersOrg4Semester/Rizzlerpies/blob/main/tracing.js'] },
      { label: '17 SigNoz dashboard', hrefs: ['http://20.251.147.233:8080/dashboard/019dd42a-6f2e-7630-bb68-beb6ed248aed?relativeTime=1d'] },
      { label: '18 SigNoz failed requests', hrefs: ['/exam-cockpit/evidence/failed-requests-by-url'] },
      { label: '01 Arkitekturdiagram', hrefs: ['/exam-cockpit/assets/arkitektur-diagram.png'] },
      { label: 'Demo End', hrefs: [] },
    ];

    let showcaseIndex = 0;
    const showcaseCurrent = document.getElementById('showcase-current');
    const showcaseNext = document.getElementById('showcase-next');

    const renderShowcase = () => {
      const isDemoEnd = showcaseFlow[showcaseIndex].hrefs.length === 0;

      showcaseCurrent.textContent = showcaseFlow[showcaseIndex].label;
      showcaseNext.disabled = isDemoEnd;
      showcaseNext.textContent = isDemoEnd ? 'Demo End' : 'Næste';
    };

    const openShowcaseStep = () => {
      const step = showcaseFlow[showcaseIndex];

      if (step.hrefs.length === 0) {
        return;
      }

      step.hrefs.forEach((href) => {
        window.open(href, '_blank', 'noopener,noreferrer');
      });

      showcaseIndex = Math.min(showcaseIndex + 1, showcaseFlow.length - 1);
      renderShowcase();
    };

    showcaseNext.addEventListener('click', openShowcaseStep);

    document.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
        event.preventDefault();
        openShowcaseStep();
      }

      if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
        event.preventDefault();

        if (showcaseIndex > 0) {
          showcaseIndex -= 1;
          renderShowcase();
          openShowcaseStep();
        }
      }
    });

    renderShowcase();
  </script>
</body>
</html>
