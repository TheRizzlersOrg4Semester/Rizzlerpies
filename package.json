{
  "name": "rizzlerpies",
  "version": "1.0.0",
  "private": true,
  "description": "RizzlerPies Node.js + Express + EJS SSR app",
  "main": "app.js",
  "scripts": {
    "db:create-migration": "node-pg-migrate create",
    "db:migrate:data": "node scripts/db/migrate-sqlite-to-postgres.js",
    "db:migrate": "node-pg-migrate up",
    "db:migrate:redo": "node-pg-migrate redo",
    "db:rollback": "node-pg-migrate down",
    "lint": "eslint .",
    "smoke:db": "bash scripts/test/smoke-db.sh",
    "start": "node app.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.21.0",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0"
  }
}
